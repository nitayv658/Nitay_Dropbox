# ──────────────────────────────────────────────────────────────────────────────
# Dropbox-sim Environment Configuration
# Copy to .env and fill in your values before running.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Used by both services. For Docker Compose the host is "postgres".
DATABASE_URL=postgresql://dropbox:secret@localhost:5432/dropboxsim

# ── Redis (Metadata Service only) ─────────────────────────────────────────────
# For Docker Compose the host is "redis".
REDIS_URL=redis://localhost:6379/0

# ── JWT (Metadata Service only) ───────────────────────────────────────────────
# IMPORTANT: generate a strong random secret before deploying.
# Example: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080  # 7 days

# ── Service-to-service auth ───────────────────────────────────────────────────
# Shared secret between Block Server and Metadata Service.
# Leave empty to disable enforcement in dev/test.
# Example: python3 -c "import secrets; print(secrets.token_hex(16))"
SERVICE_API_KEY=

# ── Block storage ─────────────────────────────────────────────────────────────
BLOCK_STORAGE_PATH=./data/blocks
STORAGE_BACKEND=local  # "local" | "s3"

# ── AWS S3 (only when STORAGE_BACKEND=s3) ─────────────────────────────────────
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Database pool ─────────────────────────────────────────────────────────────
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_COMMAND_TIMEOUT=30.0

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR

# ── Block GC ──────────────────────────────────────────────────────────────────
GC_INTERVAL_SECONDS=3600  # Run GC every hour
